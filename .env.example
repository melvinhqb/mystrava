# Créez une application sur https://www.strava.com/settings/api
# « Authorization Callback Domain » : localhost (ou votre domaine en production)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optionnel
PORT=3000
# URL publique de l'application (sert à construire l'URL de retour OAuth)
BASE_URL=http://localhost:3000
